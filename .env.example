# Copy to .env and fill in. Never commit .env.
#
# Local Docker Postgres (docker compose up -d); use the same password as POSTGRES_PASSWORD below.
# For production, replace with your Neon connection string.
DATABASE_URL=postgres://postgres:<choose-a-password>@localhost:5432/ai_investment_copilot

# Read by docker-compose.yml. Takes effect only when a NEW cluster is
# initialized (empty pgdata/); for an existing cluster change it with
# ALTER ROLE. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=

# Tests only: a database created with `npm run db:test:create` (it carries an
# explicit marker). DB-backed tests NEVER use DATABASE_URL — without this they
# fail closed before writing anything. Pure unit tests (`npm run test:unit`)
# need no database. Leave empty if you only run unit tests.
TEST_DATABASE_URL=

# Anthropic (Claude) API key — required for all AI orchestration calls.
ANTHROPIC_API_KEY=

# Financial Modeling Prep API key — required for real market data
# (price, valuation basics, company profile). Free tier: https://financialmodelingprep.com
FMP_API_KEY=

# Random 32+ char secret used to sign/encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
